generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MissionStatus {
  NEW
  MONITORING
  CRITICAL
  RESOLVED
}

enum MissionPriority {
  LOW
  MEDIUM
  HIGH
}

enum WatchlistItemStatus {
  WATCHING
  PAUSED
  ARCHIVED
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @unique
  passwordHash   String          @map("password_hash")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  sessions       Session[]
  watchlistItems WatchlistItem[]
  missions       Mission[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model SpaceObject {
  id            String          @id @default(uuid()) @db.Uuid
  externalId    String          @unique @map("external_id")
  name          String
  type          String
  source        String
  metadataJson  Json            @map("metadata_json")
  createdAt     DateTime        @default(now()) @map("created_at")
  watchlistItems WatchlistItem[]
  missions      Mission[]

  @@map("space_objects")
}

model WatchlistItem {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid @map("user_id")
  objectId  String              @db.Uuid @map("object_id")
  status    WatchlistItemStatus @default(WATCHING)
  createdAt DateTime            @default(now()) @map("created_at")
  updatedAt DateTime            @updatedAt @map("updated_at")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  object    SpaceObject         @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([userId, objectId])
  @@map("watchlist_items")
}

model Mission {
  id         String          @id @default(uuid()) @db.Uuid
  userId     String          @db.Uuid @map("user_id")
  objectId   String          @db.Uuid @map("object_id")
  title      String
  status     MissionStatus   @default(NEW)
  priority   MissionPriority @default(MEDIUM)
  notes      String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  object     SpaceObject     @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@map("missions")
}
